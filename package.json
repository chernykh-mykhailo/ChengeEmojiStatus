{
  "name": "telegram-emoji-status-rotator",
  "version": "1.0.0",
  "description": "Telegram bot & Mini App to rotate premium user emoji status daily",
  "main": "dist/index.js",
  "scripts": {
    "dev:server": "tsx watch src/index.ts",
    "build:server": "tsc",
    "dev:webapp": "npm --prefix webapp run dev",
    "build:webapp": "npm --prefix webapp run build",
    "build": "npm run build:webapp && npm run build:server",
    "start": "node dist/index.js"
  },
  "keywords": [
    "telegram",
    "bot",
    "mini-app",
    "emoji-status",
    "tma"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@grammyjs/types": "^3.19.0",
    "@hono/node-server": "^1.13.8",
    "croner": "^9.0.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
